@model CreatePersonRequest
@{
    ViewData["Title"] = "Регистрация";
}

<div class="auth-page">
    <div class="auth-container">
        <section class="auth-card">
            <header class="auth-card__header">
                <div class="auth-card__icon">
                    TD
                </div>

                <h1 class="auth-card__title">
                    Создание аккаунта
                </h1>

                <p class="auth-card__description">
                    Зарегистрируйтесь, чтобы создавать и отслеживать заявки
                </p>
            </header>

            <form class="auth-form"
                  asp-controller="Person"
                  asp-action="Register"
                  method="post">

                <div asp-validation-summary="ModelOnly"
                     class="auth-validation-summary">
                </div>

                <div class="auth-form__group">
                    <label asp-for="Email"
                           class="auth-form__label">
                        Электронная почта
                    </label>

                    <input asp-for="Email"
                           class="auth-form__input"
                           type="email"
                           autocomplete="email"
                           placeholder="example@mail.ru" />

                    <span asp-validation-for="Email"
                          class="auth-validation-message">
                    </span>
                </div>

                <div class="auth-form__group">
                    <label asp-for="Password"
                           class="auth-form__label">
                        Пароль
                    </label>

                    <input asp-for="Password"
                           class="auth-form__input"
                           type="password"
                           autocomplete="new-password"
                           placeholder="Минимум 8 символов" />

                    <span asp-validation-for="Password"
                          class="auth-validation-message">
                    </span>
                </div>

                <div class="auth-form__group">
                    <label asp-for="ConfirmPassword"
                           class="auth-form__label">
                        Повторите пароль
                    </label>

                    <input asp-for="ConfirmPassword"
                           class="auth-form__input"
                           type="password"
                           autocomplete="new-password"
                           placeholder="Повторите пароль" />

                    <span asp-validation-for="ConfirmPassword"
                          class="auth-validation-message">
                    </span>
                </div>

                <button class="button button--primary auth-form__submit"
                        type="submit">
                    Создать аккаунт
                </button>
            </form>

            <footer class="auth-card__footer">
                Уже зарегистрированы?

                <a asp-controller="Person"
                   asp-action="Login">
                    Войти
                </a>
            </footer>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}